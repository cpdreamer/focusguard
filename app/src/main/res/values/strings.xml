    <!-- setup -->
    <string name="setup_title">Set up FocusGuard</string>
    <string name="setup_intro">FocusGuard blocks distractions with device-owner rights, filters the web, and tells you what to work on next. Once you commit, nothing can be relaxed from the phone until the end date you choose (3 days, a week, …).</string>
    <string name="setup_do_ok">Device owner: active</string>
    <string name="setup_do_missing">Device owner: not active. On a computer with ADB run:\n\nadb shell dpm set-device-owner com.focusguard/.policy.GuardAdminReceiver\n\n(The phone must have no accounts added yet.) You can still try the app without it, but nothing will be enforced.</string>
