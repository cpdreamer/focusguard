<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/commitment_title_hint">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/commitment_kind"
        android:textAppearance="?attr/textAppearanceLabelLarge" />
    <Spinner
        android:id="@+id/kind"
        android:layout_width="match_parent"
        android:layout_height="48dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/commitment_days"
        android:textAppearance="?attr/textAppearanceLabelLarge" />
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/d1" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="M" />
        <com.google.android.material.button.MaterialButton android:id="@+id/d2" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="T" />
        <com.google.android.material.button.MaterialButton android:id="@+id/d3" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="W" />
        <com.google.android.material.button.MaterialButton android:id="@+id/d4" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="T" />
        <com.google.android.material.button.MaterialButton android:id="@+id/d5" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="F" />
        <com.google.android.material.button.MaterialButton android:id="@+id/d6" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="S" />
        <com.google.android.material.button.MaterialButton android:id="@+id/d7" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingHorizontal="0dp" android:text="S" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/start"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/commitment_start" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/end"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/commitment_end" />
    </LinearLayout>
</LinearLayout>
